# Practica Environment Configuration
# Copy this to .env and fill in your values

# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Database (Local Development)
DATABASE_URL=postgresql://practica:practica123@localhost:5432/practica

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# AWS Configuration (Cost-saving setup)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=practica-videos-dev
AWS_S3_REGION_NAME=us-east-1
AWS_MEDIA_CONVERT_ROLE_ARN=
AWS_MEDIA_CONVERT_ENDPOINT_URL=
AWS_MEDIA_CONVERT_QUEUE_ARN=
AWS_MEDIA_CONVERT_OUTPUT_PREFIX=processed/sessions
MEDIA_PROCESSING_CALLBACK_TOKEN=
APP_BASE_URL=http://localhost:3000
EMAIL_NOTIFICATIONS_ENABLED=false
DEFAULT_FROM_EMAIL=no-reply@practica.jpagan.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-email-password
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10

# Frontend Configuration
VITE_API_URL=http://localhost:8000
UPLOAD_MAX_BYTES=2147483648
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=3600
GUNICORN_GRACEFUL_TIMEOUT=120

# Production Settings (uncomment for production)
# DEBUG=False
# DATABASE_URL=postgresql://practica:password@your-rds-endpoint:5432/practica
