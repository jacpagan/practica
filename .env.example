DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-change-me
DATABASE_URL=postgresql://practica:practica123@db:5432/practica
REDIS_URL=redis://redis:6379/0

# Direct upload / object storage (MinIO local defaults)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=practica-local-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_ADDRESSING_STYLE=path

# Upload limits
UPLOAD_MAX_BYTES=2147483648
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Notifications
NOTIFICATIONS_PROVIDER=django_email
DEFAULT_FROM_EMAIL=noreply@practica.local

# Frontend
VITE_API_URL=http://localhost:8000

# MinIO local creds
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
